# Copy this file to `.env` in this same directory (it's gitignored by the
# repo root .gitignore) and fill in real values before deploying. None of
# these are secret except the SMTP password, which is deliberately NOT here
# — set it separately with `firebase functions:secrets:set ATLAS_SMTP_PASSWORD`
# (see infra/README.md) so it never touches a file on disk or in git.

# Same allowlist shape as the orchestrator's ATLAS_ADMIN_EMAILS — who gets
# the "new sign-up waiting on approval" email.
ATLAS_ADMIN_EMAILS=srikanthbelwadi@gmail.com

# SMTP transport. Gmail's smtp.gmail.com works with an App Password (not
# your normal account password) if ATLAS_SMTP_USER is a Gmail address; any
# other SMTP provider (SendGrid's smtp.sendgrid.net, etc.) works the same
# way — host/port/user here, password via the secret above.
ATLAS_SMTP_HOST=smtp.gmail.com
ATLAS_SMTP_PORT=587
ATLAS_SMTP_USER=your-sending-account@gmail.com
ATLAS_SMTP_FROM=your-sending-account@gmail.com

# Where the email's "approve or reject it here" link points.
ATLAS_ADMIN_CONSOLE_URL=https://atlas-web--atlas-ard-okf.us-central1.hosted.app/admin
